# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=netflix_user
DATABASE_PASSWORD=netflix_password
DATABASE_NAME=netflix_db
DATABASE_URL=postgresql://netflix_user:netflix_password@localhost:5432/netflix_db

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=netflix_development_jwt_secret_key_32_characters_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=netflix_development_refresh_secret_key_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / S3 Object Storage
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MEDIA=netflix-media
STORAGE_BUCKET_THUMBNAILS=netflix-thumbnails
